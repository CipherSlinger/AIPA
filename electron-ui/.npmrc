# Electron binary download mirror.
#
# @electron/get reads the `npm_config_electron_mirror` env var that npm derives
# from this key, which is how the Electron binary download is pointed at the
# npmmirror CDN instead of GitHub releases.
#
# npm prints `Unknown project config "electron_mirror"` on every command because
# the key is not one of npm's own settings. That warning is expected: npm still
# exports it to lifecycle scripts, which is the whole point. If a future npm
# major drops unknown-key export, set ELECTRON_MIRROR in your shell instead.
electron_mirror=https://npmmirror.com/mirrors/electron/